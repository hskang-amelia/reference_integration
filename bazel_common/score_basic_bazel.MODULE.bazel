# https://github.com/grpc/grpc-java/issues/12165
bazel_dep(name = "grpc-java", version = "1.78.0")

# Required by score_someip_gateway to build vsomeip via rules_foreign_cc. The gateway applies
# these patches in its own MODULE.bazel, but overrides only take effect in the root module.
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
single_version_override(
    module_name = "rules_foreign_cc",
    patch_strip = 1,
    patches = [
        "//patches/rules_foreign_cc:001-dont-block-network.patch",
        "//patches/rules_foreign_cc:002-fix-proc-self-cwd.patch",
    ],
)
